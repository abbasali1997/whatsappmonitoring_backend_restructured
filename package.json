{
  "name": "unicx-integration",
  "version": "1.0.0",
  "description": "UNICX Integration Backend with NestJS and Azure CosmosDB Mongo API",
  "author": "UNICX Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.api.json && tsc -p tsconfig.worker.json",
    "start": "node -r tsconfig-paths/register dist/api/apps/api/main.js",
    "start:dev": "nest start --watch --entryFile apps/api/main -r tsconfig-paths/register",
    "start:debug": "nest start --debug --watch --entryFile apps/api/main -r tsconfig-paths/register",
    "start:prod": "node dist/main",
    "start:worker": "node -r tsconfig-paths/register dist/worker/apps/worker/main.js",
    "start:worker:dev": "nest start --watch --entryFile apps/worker/main -r tsconfig-paths/register",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:e2e": "jest --config ./test/jest-e2e.json --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:all": "npm run test && npm run test:e2e",
    "test:security": "jest --config ./test/jest-e2e.json test/security",
    "seed": "npm run build && node scripts/seed-database.js",
    "seed:clean": "npm run build && node scripts/seed-database.js --clean"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "@aws-sdk/s3-request-presigner": "^3.913.0",
    "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.32",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.28.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^5.0.1",
    "@nestjs/websockets": "^10.0.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.45.0",
    "@opentelemetry/instrumentation": "^0.51.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.24.0",
    "@opentelemetry/sdk-trace-node": "^1.24.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.69.3",
    "cache-manager": "^7.2.4",
    "cache-manager-redis-yet": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "crypto": "^1.0.1",
    "express-rate-limit": "^7.1.5",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.0",
    "joi": "^17.11.0",
    "libphonenumber-js": "^1.10.51",
    "moment": "^2.29.4",
    "mongodb": "^7.0.0",
    "mongoose": "^8.0.3",
    "nodemailer": "^6.9.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "puppeteer": "^24.37.2",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "whatsapp-web.js": "^1.34.6",
    "wwebjs-mongo": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.e2e-spec.ts",
      "!**/*.interface.ts",
      "!**/*.dto.ts",
      "!**/*.module.ts",
      "!**/*.controller.ts",
      "!main.ts",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/coverage/**",
      "!**/test/**",
      "!telemetry.ts",
      "!config/**/*.ts",
      "!common/logger/**/*.ts",
      "!common/validation/**/*.ts",
      "!common/security/**/*.ts",
      "!common/cache/**/*.ts",
      "!common/messaging/messaging.module.ts",
      "!common/messaging/queue.service.ts",
      "!common/messaging/messaging.service.ts",
      "!common/constants/system-entity.ts",
      "!common/health/health.service.ts",
      "!common/interceptors/telemetry.interceptor.ts",
      "!modules/auth/**/*.ts",
      "!modules/users/**/*.ts",
      "!modules/whatsapp/**/*.ts",
      "!modules/entities/entities.service.ts",
      "!modules/storage/storage.service.ts",
      "!modules/email/email-queue.processor.ts",
      "!modules/email/email.service.ts",
      "!modules/entity-types/entity-types.service.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@/common/(.*)$": "<rootDir>/common/$1",
      "^@/modules/(.*)$": "<rootDir>/modules/$1",
      "^@/config/(.*)$": "<rootDir>/config/$1"
    },
    "testTimeout": 30000
  }
}
