<!DOCTYPE html>
<html lang="{{lang}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{emailTitle}}</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #222222;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
        }
        .email-wrapper {
            width: 100%;
            background-color: #f5f5f5;
            padding: 40px 0;
        }
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border: 1px solid #e0e0e0;
        }
        .header {
            padding: 30px 40px;
            border-bottom: 3px solid #14a800;
            background-color: #ffffff;
        }
        .logo {
            max-width: 150px;
            height: auto;
            display: block;
        }
        .content {
            padding: 40px;
        }
        .greeting {
            font-size: 18px;
            font-weight: 400;
            color: #222222;
            margin: 0 0 20px 0;
        }
        .message {
            font-size: 15px;
            color: #555555;
            line-height: 1.7;
            margin: 0 0 30px 0;
        }
        .info-box {
            background-color: #f9f9f9;
            border: 1px solid #e0e0e0;
            border-left: 3px solid #14a800;
            border-radius: 4px;
            padding: 25px;
            margin: 30px 0;
        }
        .info-box-title {
            font-size: 14px;
            font-weight: 600;
            color: #222222;
            margin: 0 0 15px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #e8e8e8;
        }
        .info-row:last-child {
            border-bottom: none;
        }
        .info-label {
            font-size: 14px;
            color: #666666;
            font-weight: 400;
        }
        .info-value {
            font-size: 14px;
            color: #222222;
            font-weight: 500;
            font-family: 'Courier New', monospace;
        }
        .button-container {
            text-align: center;
            margin: 35px 0;
        }
        .button {
            display: inline-block;
            background-color: #14a800;
            color: #ffffff;
            text-decoration: none;
            padding: 12px 32px;
            border-radius: 4px;
            font-size: 15px;
            font-weight: 500;
            letter-spacing: 0.3px;
        }
        .button:hover {
            background-color: #0d7d00;
        }
        .security-notice {
            background-color: #f0f9f0;
            border-left: 3px solid #14a800;
            padding: 20px;
            margin: 30px 0;
        }
        .security-notice-title {
            font-size: 14px;
            font-weight: 600;
            color: #222222;
            margin: 0 0 10px 0;
        }
        .security-notice-text {
            font-size: 14px;
            color: #555555;
            line-height: 1.6;
            margin: 0;
        }
        .divider {
            height: 1px;
            background-color: #e0e0e0;
            margin: 30px 0;
        }
        .footer {
            padding: 30px 40px;
            background-color: #f9f9f9;
            border-top: 1px solid #e0e0e0;
        }
        .footer-text {
            font-size: 13px;
            color: #666666;
            line-height: 1.6;
            margin: 0 0 15px 0;
        }
        .footer-links {
            margin: 20px 0;
        }
        .footer-links a {
            color: #14a800;
            text-decoration: none;
            font-size: 13px;
            margin-right: 20px;
        }
        .footer-links a:hover {
            text-decoration: underline;
        }
        .footer-company {
            font-size: 12px;
            color: #999999;
            line-height: 1.6;
        }
        .footer-content {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            align-items: center;
        }
        @media only screen and (max-width: 600px) {
            .email-container {
                width: 100% !important;
            }
            .header, .content, .footer {
                padding: 25px !important;
            }
            .info-row {
                flex-direction: column;
            }
            .info-value {
                margin-top: 5px;
            }
        }
    </style>
</head>
<body>
    <div class="email-wrapper">
        <div class="email-container">
            <!-- Header -->
            <div class="header">
                <div style="font-size: 24px; font-weight: 600; color: #14a800;">{{companyName}}</div>
            </div>

            <!-- Content -->
            <div class="content">
                <p class="greeting">{{greeting}} {{firstName}},</p>
                
                <p class="message">
                    {{intro}}
                </p>

                <!-- Login Credentials -->
                <div class="info-box">
                    <div class="info-box-title">{{credentialsTitle}}</div>
                    <div class="info-row">
                        <span class="info-label">{{labelEmail}}</span>
                        <span class="info-value">{{email}}</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">{{labelTempPassword}}</span>
                        <span class="info-value">{{tempPassword}}</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">{{labelEntity}}</span>
                        <span class="info-value">{{entity.name}}</span>
                    </div>
                </div>

                <!-- Call to Action -->
                <div class="button-container">
                    <a href="{{loginUrl}}" class="button">{{buttonLabel}}</a>
                </div>

                <!-- Security Notice -->
                <div class="security-notice">
                    <div class="security-notice-title">{{securityTitle}}</div>
                    <p class="security-notice-text">
                        {{securityText}}
                    </p>
                </div>

                <div class="divider"></div>

                <p class="message" style="margin-bottom: 0;">
                    {{helpText}}
                </p>
            </div>

        </div>
    </div>
</body>
</html>
