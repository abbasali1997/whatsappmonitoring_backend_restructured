<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email - {{companyName}}</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #222222;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
        }
        .email-wrapper {
            width: 100%;
            background-color: #f5f5f5;
            padding: 40px 0;
        }
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border: 1px solid #e0e0e0;
        }
        .header {
            padding: 30px 40px;
            border-bottom: 3px solid #14a800;
            background-color: #ffffff;
        }
        .logo {
            max-width: 150px;
            height: auto;
            display: block;
        }
        .content {
            padding: 40px;
        }
        .greeting {
            font-size: 18px;
            font-weight: 400;
            color: #222222;
            margin: 0 0 20px 0;
        }
        .message {
            font-size: 15px;
            color: #555555;
            line-height: 1.7;
            margin: 0 0 30px 0;
        }
        .button-container {
            text-align: center;
            margin: 35px 0;
        }
        .button {
            display: inline-block;
            background-color: #14a800;
            color: #ffffff;
            text-decoration: none;
            padding: 12px 32px;
            border-radius: 4px;
            font-size: 15px;
            font-weight: 500;
            letter-spacing: 0.3px;
        }
        .button:hover {
            background-color: #0d7d00;
        }
        .expiry-notice {
            background-color: #f0f9f0;
            border-left: 3px solid #14a800;
            padding: 20px;
            margin: 30px 0;
        }
        .expiry-notice-title {
            font-size: 14px;
            font-weight: 600;
            color: #222222;
            margin: 0 0 10px 0;
        }
        .expiry-notice-text {
            font-size: 14px;
            color: #555555;
            line-height: 1.6;
            margin: 0;
        }
        .security-notice {
            background-color: #f9f9f9;
            border: 1px solid #e0e0e0;
            border-left: 3px solid #14a800;
            border-radius: 4px;
            padding: 20px;
            margin: 30px 0;
        }
        .security-notice-title {
            font-size: 14px;
            font-weight: 600;
            color: #222222;
            margin: 0 0 10px 0;
        }
        .security-notice-list {
            font-size: 14px;
            color: #555555;
            line-height: 1.8;
            margin: 0;
            padding-left: 20px;
        }
        .security-notice-list li {
            margin-bottom: 8px;
        }
        .link-text {
            word-break: break-all;
            font-size: 13px;
            color: #666666;
            background-color: #f9f9f9;
            padding: 15px;
            border-radius: 4px;
            margin: 20px 0;
            font-family: 'Courier New', monospace;
        }
        .divider {
            height: 1px;
            background-color: #e0e0e0;
            margin: 30px 0;
        }
        .footer {
            padding: 30px 40px;
            background-color: #f9f9f9;
            border-top: 1px solid #e0e0e0;
        }
        .footer-text {
            font-size: 13px;
            color: #666666;
            line-height: 1.6;
            margin: 0 0 15px 0;
        }
        .footer-links {
            margin: 20px 0;
        }
        .footer-links a {
            color: #14a800;
            text-decoration: none;
            font-size: 13px;
            margin-right: 20px;
        }
        .footer-links a:hover {
            text-decoration: underline;
        }
        .footer-company {
            font-size: 12px;
            color: #999999;
            line-height: 1.6;
        }
        .footer-content{
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            align-items: center;
        }
        @media only screen and (max-width: 600px) {
            .email-container {
                width: 100% !important;
            }
            .header, .content, .footer {
                padding: 25px !important;
            }
        }
    </style>
</head>
<body>
    <div class="email-wrapper">
        <div class="email-container">
            <!-- Header -->
            <div class="header">
                <div style="font-size: 24px; font-weight: 600; color: #14a800;">{{companyName}}</div>
            </div>

            <!-- Content -->
            <div class="content">
                <p class="greeting">{{greeting}} {{firstName}} {{lastName}},</p>
                
                <p class="message">
                    {{intro}}
                </p>

                <!-- Call to Action -->
                <div class="button-container">
                    <a href="{{verificationLink}}" class="button">{{buttonLabel}}</a>
                </div>

                <!-- Expiry Notice -->
                <div class="expiry-notice">
                    <div class="expiry-notice-title">{{importantTitle}}</div>
                    <p class="expiry-notice-text">
                        {{importantText}}
                    </p>
                </div>

                <!-- Security Notice -->
                <div class="security-notice">
                    <div class="security-notice-title">{{securityTitle}}</div>
                    <ul class="security-notice-list">
                        <li>{{securityItem1}}</li>
                        <li>{{securityItem2}}</li>
                        <li>{{securityItem3}}</li>
                    </ul>
                </div>

                <p class="message">
                    {{linkHelp}}
                </p>
                <div class="link-text">{{verificationLink}}</div>

                <div class="divider"></div>

                <p class="message" style="margin-bottom: 0;">
                    {{supportText}}
                </p>
            </div>

        </div>
    </div>
</body>
</html>
